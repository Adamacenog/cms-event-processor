{
  "info": {
    "name": "CMS Event Processor - ingestion and consumers",
    "description": "Synthetic synchronous ingestion and consumer walkthrough. Run in order with private CMS, reader, and administrator credentials. Fresh source IDs/keys are generated by the first request; consumers query immediately after committed responses.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{cmsUsername}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{cmsPassword}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "entityId",
      "value": ""
    },
    {
      "key": "batchKey",
      "value": ""
    },
    {
      "key": "batchBody",
      "value": ""
    },
    {
      "key": "committedBatchId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Commit publish and unseen-revision unpublish",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{batchKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/cms/events",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "cms",
            "events"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{{batchBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Confidential responses are not cached\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\"));",
              "pm.test(\"Batch committed\", () => pm.response.to.have.status(200));",
              "const result = pm.response.json();",
              "pm.test(\"Final decisions preserve input order\", () => pm.expect(result.outcomes.map(x => x.reasonCode)).to.eql([\"published\",\"unpublished\"]));",
              "pm.collectionVariables.set(\"committedBatchId\", result.batchId);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const id = \"postman-\" + pm.variables.replaceIn(\"{{$guid}}\");",
              "pm.collectionVariables.set(\"entityId\", id);",
              "pm.collectionVariables.set(\"batchKey\", pm.variables.replaceIn(\"{{$guid}}\"));",
              "pm.collectionVariables.set(\"batchBody\", JSON.stringify([{type:\"publish\",id,version:1,timestamp:\"2026-01-01T12:00:00Z\",payload:{title:\"Synthetic example\"}},{type:\"unPublish\",id,version:2,timestamp:\"2026-01-01T12:01:00Z\",payload:{title:\"Synthetic unpublished revision\"}}]));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Replay the original exact keyed body",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{batchKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/cms/events",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "cms",
            "events"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{{batchBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Confidential responses are not cached\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\"));",
              "pm.test(\"Original successful result replayed\", () => { pm.response.to.have.status(200); pm.expect(pm.response.json().batchId).to.eql(pm.collectionVariables.get(\"committedBatchId\")); });"
            ]
          }
        }
      ]
    },
